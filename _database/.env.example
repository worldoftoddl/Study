# === K-IFRS RAG Pipeline 환경변수 ===

# Upstage Solar Embedding API 키
UPSTAGE_API_KEY=your_upstage_api_key_here

# Anthropic Claude API 키
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM 모델명 (기본값: claude-haiku-4-5-20251001)
# 운영 전환 시: claude-sonnet-4-5-20250514
LLM_MODEL=claude-haiku-4-5-20251001

# Reranker 타입: "local" 또는 "cohere" (기본값: local)
# local: dragonkue/bge-reranker-v2-m3-ko (무료, GPU 권장)
# cohere: Cohere Rerank API (유료, COHERE_API_KEY 필요)
RERANKER_TYPE=local

# Cohere API 키 (RERANKER_TYPE=cohere 일 때만 필요)
COHERE_API_KEY=your_cohere_api_key_here
