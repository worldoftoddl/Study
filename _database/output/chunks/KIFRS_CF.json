    {
      "chunk_id": "KIFRS_CF_main_3.17_s1",
      "parent_id": "KIFRS_CF_main_보고기업_문단",
      "content": "참조).",
      "metadata": {
        "standard_id": "KIFRS_CF",
        "standard_name": "재무보고를 위한 개념체계",
        "section_type": "main",
