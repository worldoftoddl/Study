      }
    },
    {
      "chunk_id": "KIFRS1020_main_7_s5",
      "parent_id": "KIFRS1020_main_한국회계기준원_회계기준위원회_의결_2015._9._25.",
      "content": "이러한\n저작물은 국제회계기준위원회가 제정 또는 채택한 번호가 매겨진 모든 국제회계기준(IAS)\n및 국제재무보고기준(IFRS)의 본문, 또는 국제회계기준해석위원회(IFRS IC)나 상설해석위원회\n(SIC)가 발표한 해석서의 본문(이하 ‘기준서 본문’)으로 구성됩니다.",
      "metadata": {
        "standard_id": "KIFRS1020",
        "standard_name": "정부보조금의 회계처리와 정부지원의 공시",
        "section_type": "main",
        "para_number": "7",
        "heading_context": "한국회계기준원 회계기준위원회 의결 2015. 9. 25.",
        "cross_refs": [],
        "has_table": false,
        "has_example": false,
        "is_sentence_split": true,
        "split_index": 5,
