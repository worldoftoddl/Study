# === Tax Agent Pipeline 환경변수 ===

# Upstage Solar Embedding API 키
UPSTAGE_API_KEY=your_key_here

# Anthropic Claude API 키
ANTHROPIC_API_KEY=your_key_here

# LangSmith API 키 (프롬프트 pull용)
LANGSMITH_API_KEY=your_key_here

# Tavily API 키 (부동산세 웹 검색용)
TAVILY_API_KEY=your_key_here

# ── LLM 모델 (환경변수로 전환 가능) ──
SMART_LLM_MODEL=claude-opus-4-5-20251101
LLM_MODEL=claude-sonnet-4-5-20250929
SMALL_LLM_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.1

# ── Embedding ──
EMBEDDING_MODEL=solar-embedding-1-large

# ── Chroma DB (Self-RAG) ──
COLLECTION_NAME=chroma-tax
DB_PERSIST_DIR=./preprocessed-upstage

# ── Chroma DB (부동산세) ──
RE_COLLECTION_NAME=real_estate_tax
RE_DB_PERSIST_DIR=./real_estate_tax_collection

# ── Retriever ──
RETRIEVER_SEARCH_TYPE=mmr
RETRIEVER_K=10
RETRIEVER_FETCH_K=50
RETRIEVER_LAMBDA_MULT=0.6
